{
  "manifest_version": 3,
  "name": "Straight Cut",
  "version": "0.1.0",
  "description": "Removes YouTube ads before the player sees them, and skips the ones that slip through.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Straight Cut",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "network",
        "enabled": true,
        "path": "rules/network.json"
      }
    ]
  }
}
